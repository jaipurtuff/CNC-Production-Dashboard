# =====================================================================
# CNC Production Monitoring & Live Dashboard - Environment Configuration
# Designed to run locally on your Windows PC using a local .env file.
# =====================================================================

# PostgreSQL Connection (Permanent Industrial History)
# When running on your local Windows PC, replace <MY_LOCAL_PASSWORD> with your local postgres password
DATABASE_URL="postgresql://cnc_user:<MY_LOCAL_PASSWORD>@localhost:5432/cnc_dashboard"

# CNC Machine Configuration (Windows Read-Only UNC Share)
# Exact network path to CNC machine shared folder on shop floor LAN
CNC_SHARE_PATH="\\\\192.168.11.211\\iso"
CNC_SCAN_INTERVAL_MS=5000
CNC_OFFLINE_GRACE_SEC=30

# Google Sheets API Configuration (Automatic background sync every 5 minutes)
GOOGLE_SHEET_ID="1Xs0EUIs0H7fgdkwlwFOmM5HBjJ1SXzz4-D-QxGA8euM"
GOOGLE_SHEET_RANGE="Sheet1!A:E"
GOOGLE_SHEET_SYNC_INTERVAL_MS=300000

# Google Service Account Credentials
# Path to your downloaded service account JSON key on your local PC
GOOGLE_APPLICATION_CREDENTIALS="./credentials/google-service-account.json"
GOOGLE_SERVICE_ACCOUNT_EMAIL="cnc-dashboard-sync@cnc-production-dashboard.iam.gserviceaccount.com"

# Web Server Port
PORT=3000
